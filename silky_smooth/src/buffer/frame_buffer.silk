import buffer.pixel { Pixel }
import lib.std.testing { AssertionError }
import silk.io.logger { LogError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.num.usize
import lib.std.testing
import silk.core.effect { Effect }
import silk.system.filesystem_native { OsFileSystem }
import silk.system.filesystem { FileError, Path, FileSystem }
import silk.text.format { Format, Debug, Formatter }
import silk.io.writer { WriterError, Writer }
import silk.collections.list { List }
import lib.std.time { Instant }
import lib.std.println { println }
import lib.std.format { format }
import lib.bytemuck
import silk.platform.native.filesystem { NativeFileSystem }

pub struct PPMWriteError {
  message: string<'static>
}

impl Debug for PPMWriteError {
  /// Writes `PPMWritError`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugFields(self, "PPMWriteError", &mut formatter)
  }
}

pub effect fn writeP7(width: u32, height: u32, pixel_grid: &[Pixel]) -> ()
  ! FileError | OutOfMemoryError | PPMWriteError | LogError | WriterError | bytemuck.PodCastError
  ? &mut Allocator | &mut FileSystem {
  if u32.checkedSubtract(usize.toU32(pixel_grid.length), width * height).isNone() {
    fail PPMWriteError { message: "Pixel count exceeds pixel_grid length" }
  }

  let formatted_bytes = (run format(
    "P7\nWIDTH {0}\nHEIGHT {1}\nDEPTH {2}\nMAXVAL {3}\nTUPLTYPE {4}\nENDHDR\n",
    &.(width, height, 4, 255, "RGB_ALPHA"),
  )).intoBytes()
  let header_bytes = formatted_bytes.asSlice()
  let pixel_bytes = run bytemuck.castSlice<u8>(pixel_grid)

  let project = run Path.make("/home/mich/Projects/silky_smooth/out")
  let pam_file = run Path.join(&project, "out.pam")

  run FileSystem.createDirectoriesRecursively(&project)
  let mut file_handle = run NativeFileSystem.openFile(
    b"/",
    pam_file.rawBytes(),
    true,
    FileSystem.operationCode(FileSystem.createFileOperation())
      | FileSystem.operationCode(FileSystem.writeFileOperation()),
  )

  let mut instant = Instant.now()

  // write the header
  run NativeFileSystem.writeFile(
    &mut file_handle,
    header_bytes,
    FileSystem.operationCode(FileSystem.writeFileOperation()),
  )
  run println("wrote header in: {:?}ms", &.(instant.elapsed().asMillis()))
  instant = Instant.now()

  // write the samples
  run NativeFileSystem.writeFile(
    &mut file_handle,
    pixel_bytes,
    FileSystem.operationCode(FileSystem.writeFileOperation()),
  )
  run println("wrote samples in: {:?}ms", &.(instant.elapsed().asMillis()))
  run NativeFileSystem.closeFile(move file_handle, FileSystem.writeFileOperation())
}

test effect fn testWriteP3() -> ()
  ! AssertionError<'static>
    | FileError
    | OutOfMemoryError
    | LogError
    | PPMWriteError
    | bytemuck.PodCastError
    | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut(&mut allocator)
  let mut pixels = run List<Pixel>.makeWithCapacity(3840 * 2160)
    |> Effect.provideMut(&mut allocator)
  run pixels.appendRepeated(Pixel.opaque(255, 0, 0), 3840 * 2160)
    |> Effect.provideMut(&mut allocator)

  run writeP7(3840, 2160, pixels.asSlice())
    |> Effect.provideMut(&mut files)
    |> Effect.provideMut(&mut allocator)
  let project = run Path.make("/home/mich/Projects/silky_smooth/out")
    |> Effect.provideMut(&mut allocator)

  let ppm_file = run Path.join(&project, "out.ppm") |> Effect.provideMut(&mut allocator)

  let check = run FileSystem.exists(&ppm_file) |> Effect.provideMut(&mut files)
  run testing.expect(check == true, "out.ppm file wasn't made")
}
