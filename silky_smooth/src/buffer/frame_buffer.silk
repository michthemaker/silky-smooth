import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

pub struct PPMWriteError {
  message: string<'static>
}

impl Debug for PPMWriteError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugFields(self, "PPMWriteError", &mut formatter)
  }
}

pub effect fn writeP7(width: u32, height: u32, pixel_grid: &[Pixel]) -> ()
  ! FileError | OutOfMemoryError | PPMWriteError | WriterError | bytemuck.PodCastError
  ? &mut Allocator | &mut FileSystem {
  if u32.checkedSubtract(usize.toU32(pixel_grid.length), width * height).isNone() {
    fail PPMWriteError { message: "Pixel count exceeds pixel_grid length" }
  }

  let formatted_bytes = (run format(
    "P7\nWIDTH {0}\nHEIGHT {1}\nDEPTH {2}\nMAXVAL {3}\nTUPLTYPE {4}\nENDHDR\n",
    &.(width, height, 4, 255, "RGB_ALPHA"),
  )).intoBytes()
  let header_bytes = formatted_bytes.asSlice()
  let pixel_bytes = run bytemuck.castSlice<u8>(pixel_grid)

  let project = run Path.make("/home/mich/Projects/silky_smooth/out")
  let pam_file = run Path.join(&project, "out.pam")

  run FileSystem.createDirectoriesRecursively(&project)
  let mut file_handle = run NativeFileSystem.openFile(
    b"/",
    pam_file.rawBytes(),
    true,
    FileSystem.operationCode(FileSystem.createFileOperation())
      | FileSystem.operationCode(FileSystem.writeFileOperation()),
  )

  let mut instant = Instant.now()

  // write the header
  run NativeFileSystem.writeFile(
    &mut file_handle,
    header_bytes,
    FileSystem.operationCode(FileSystem.writeFileOperation()),
  )
  println("wrote header in: {:?}ms", &.(instant.elapsed().asMillis()))
  instant = Instant.now()

  // write the samples
  run NativeFileSystem.writeFile(
    &mut file_handle,
    pixel_bytes,
    FileSystem.operationCode(FileSystem.writeFileOperation()),
  )
  println("wrote samples in: {:?}ms", &.(instant.elapsed().asMillis()))
  run NativeFileSystem.closeFile(move file_handle, FileSystem.writeFileOperation())
}

pub struct Framebuffer {
  width: u32,
  height: u32,
  buffer: List<Pixel>
}

impl Framebuffer {
  pub effect fn new(w: u32, h: u32) -> Framebuffer
    ! OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    let buffer: List<Pixel> = run List<Pixel>.makeWithCapacity(
      u32.toUsize(from<u32>(from<u128>(w) * from<u128>(h))),
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    return Framebuffer { width: move w, height: move h, buffer: move buffer }
  }
}

impl Debug for Framebuffer {
  effect fn debug(self: &Framebuffer, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Format.debugFields(self, "Framebuffer", &mut formatter)
  }
}

test effect fn testFrameBuffer() -> ()
  ! testing.AssertionError<'static> | OutOfMemoryError {
  println("{:?}", &.(run Framebuffer.new(9, 10)))
  // run testing.expect( == 42, "double(21) is 42")
}
