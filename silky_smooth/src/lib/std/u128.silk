  fn digitPairs() -> &'static [u8] {
    return b"00010203040506070809101112131415161718192021222324252627282930313233343536373839404142434445464748495051525354555657585960616263646566676869707172737475767778798081828384858687888990919293949596979899"
  }

  // A decimal number with no width, precision or forced sign is its digits alone, written at once.
  fn plainNumber(formatter: &Formatter) -> bool {
    return !Format.hasWidth(&formatter) && !Format.hasPrecision(&formatter)
      && Format.sign(formatter) == Sign.NegativeOnly
  }

  // Writes the decimal digits of `value` at the end of `digits`, two at a time, and returns the index
  // of the first one.
  fn writeDecimalDigits(digits: &mut [u8; 39], value: u128) -> usize {
    let pairs = U128Format.digitPairs()
    let mut start = DIGIT_CAPACITY
    let mut remaining = value
    while &HUNDRED <= &remaining {
      let qr = U128Operations.divRem(remaining, HUNDRED)
      let pair = u64.toUsize(qr.rem.lo) * 2
      remaining = qr.quot
      start = start - 2
      digits[start] = pairs[pair]
      digits[start + usize.ONE] = pairs[pair + usize.ONE]
    }
    if &TEN <= &remaining {
      let pair = u64.toUsize(remaining.into<u64>()) * 2
      start = start - 2
      digits[start] = pairs[pair]
      digits[start + usize.ONE] = pairs[pair + usize.ONE]
      return start
    }
    start = start - usize.ONE
    digits[start] = ASCII_ZERO + u64.toU8(remaining.into<u64>())
    return start
  }

  effect fn radixDisplay(formatter: &mut Formatter, value: u128) -> ()
    ! WriterError
    ? &mut Writer {
    let style = Format.style(&formatter)
    let mut shift: u64 = 4
    let mut prefix = "0x"

    // Added to a digit of 10 or more: `a` is 97 and `A` is 65.
    let mut letterBase: u8 = 87
    if style == Style.UpperHex {
      letterBase = 55
    }
    if style == Style.Octal {
      shift = 3
      prefix = "0o"
    }
    if style == Style.Binary {
      shift = 1
      prefix = "0b"
    }
    if !Format.alternate(&formatter) {
      prefix = ""
    }
    let mask = u64.shiftLeft(1, shift) - 1
    let mut digits = U128Format.emptyRadixDigits()
    let mut start: usize = 128
    let mut remaining = value
    start = start - usize.ONE
    digits[start] = U128Format.radixDigit(
      u64.toU8((remaining & mask.into<u128>()).into<u64>()),
      letterBase,
    )
    remaining = u128.shiftRight(remaining, u64.toU32(shift))
    while &remaining != &ZERO {
      start = start - usize.ONE
      digits[start] = U128Format.radixDigit(
        u64.toU8((remaining & mask.into<u128>()).into<u64>()),
        letterBase,
      )
      remaining = u128.shiftRight(remaining, u64.toU32(shift))
    }
    return run U128Format.emitInteger(&mut formatter, false, prefix, &digits, start, 128 - start)
  }

  fn radixDigit(digit: u8, letterBase: u8) -> u8 {
    if digit < 10 {
      return ASCII_ZERO + digit
    }
    return letterBase + digit
  }
}

struct U128Operations {}

impl U128Operations {
  fn equals(left: &u128, right: &u128) -> bool {
    return left.hi == right.hi && left.lo == right.lo
  }

  fn multiplyOverflows(left: u128, right: u128) -> bool {
    // Both high limbs set: the product is at least 2^128.
    if left.hi != 0 && right.hi != 0 {
      return true
    }

    // A cross term wider than 64 bits lands past bit 127.
    if u64.multiplyHigh(left.hi, right.lo) != 0 {
      return true
    }
    if u64.multiplyHigh(left.lo, right.hi) != 0 {
      return true
    }

    // At most one cross term is nonzero here. Adding it to the high half of lo*lo can still carry out.
    let cross = u64.wrappingAdd(
      u64.wrappingMultiply(left.hi, right.lo),
      u64.wrappingMultiply(left.lo, right.hi),
    )
    let high = u64.wrappingAdd(u64.multiplyHigh(left.lo, right.lo), cross)
    return high < cross
  }

  fn bitAt(value: u128, index: u64) -> u64 {
    if index >= 64 {
      return u64.bitAnd(u64.shiftRight(value.hi, index - 64), 1)
    }
    return u64.bitAnd(u64.shiftRight(value.lo, index), 1)
  }

  // Binary long division. Requires `d != 0`.
  fn divRem(n: u128, d: u128) -> DivRem {
    if n.hi == 0 && d.hi == 0 {
      return DivRem {
        quot: make(0, u64.divide(n.lo, d.lo)),
        rem: make(0, u64.remainder(n.lo, d.lo)),
      }
    }
    let mut quot = MIN
    let mut rem = MIN
    let mut i = BITS - u128.leadingZeros(n)
    while i > 0 {
      i = i - 1

      // If the top bit of rem is about to shift out, rem is already larger than d.
      let lost = u64.shiftRight(rem.hi, 63) != 0
      rem = u128.bitOr(u128.shiftLeft(rem, 1), make(0, U128Operations.bitAt(n, u32.toU64(i))))
      if lost || !u128.lessThan(rem, d) {
        rem = u128.wrappingSubtract(rem, d)
        quot = u128.bitOr(quot, u128.shiftLeft(ONE, i))
      }
    }
    return DivRem { quot: quot, rem: rem }
  }
}
