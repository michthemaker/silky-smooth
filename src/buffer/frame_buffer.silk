test effect fn testWriteP3() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError | LogError | PPMWriteError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run OsFileSystem.make("/") |> Effect.provideMut(&mut allocator)
  run writeP3(
    2,
    2,
    &[
      Pixel(255, 0, 0, 255),
      Pixel(0, 255, 0, 255),
      Pixel(0, 0, 255, 255),
      Pixel(255, 255, 255, 255),
    ],
  )
    |> Effect.provideMut(&mut files)
    |> Effect.provideMut(&mut allocator)
  // run println("{}", &.(unsafe String.fromUtf8Unchecked(captureWriter.toBytes().asSlice())))

  // let mut captureWriter_2 = Default.default<CaptureWriter>()
