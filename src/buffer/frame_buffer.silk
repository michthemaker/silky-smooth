  //     run format("{0}\n", &.(255)),
  //   ]
  //   let mut index: usize = 0
  //   while index < headers.length {
  //     let header = &headers[index]
  //     run Format.write(&mut formatter, header.ownedUtf8Bytes())
  //     index = index + 1
  //   }
  //   let w = u32.toUsize(width)
  //   let h = u32.toUsize(height)
  //
  //   let mut rows = range(0, h)
  //   while let Step.Index { i: y } = rows.next() {
  //     let mut cols = range(0, w)
  //     while let Step.Index { i: x } = cols.next() {
  //       // 0 * 2 = 0 + 0 = 0
