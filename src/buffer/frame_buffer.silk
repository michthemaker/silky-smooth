pub const hold: i32 = 0

pub struct PPMWriteError {
  pub message: string<'static>
}

pub effect fn writeP3(width: u32, height: u32, pixel_grid: &[Pixel]) -> ()
  ! FileError | OutOfMemoryError | PPMWriteError | LogError
  ? &mut Allocator | &mut FileSystem {
  if u32.checkedSubtract(usize.toU32(pixel_grid.length), width * height).isNone() {
    fail PPMWriteError { message: "Pixel count exceeds pixel_grid length" }
  }

  let project = run Path.make("/home/mich/Projects/silky_smooth")

  // let silk_toml_path = run project.join("silk.toml")
  let dir = run FileSystem.listDirectory(&project)

  let mut iter = range(0, dir.length())
  while let Step.Index { i } = iter.next() {
    let dir_entry_slice = dir.asSlice()
    let path = &dir_entry_slice[i].path

    run println("{:?}", &.(path.view().unwrapOr("")))
  }
