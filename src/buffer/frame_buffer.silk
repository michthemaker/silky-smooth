import buffer.pixel { Pixel }
import lib.testing { AssertionError }
import lib.testing
import silk.text.format { Format }
import silk.io.writer { WriterError, Writer }
import silk.core.effect { Effect }
import lib.capture_writer { CaptureWriter }
import lib.default { Default }
import lib.format { formatToBytes }

pub effect fn writeP3(width: u8, height: u8, max_channel: u8, pixels: [Pixel; 4]) -> ()
  ! WriterError
  ? &mut Writer {
  let mut formatter = Format.makeDefault()
  run Format.write(&mut formatter, b"P3\n")
  let bytes = formatToBytes("", &.(9, 2))
  // run Format.write(&mut formatter, Format.format)
}

test effect fn testWriteP3() -> ()
  ! AssertionError<'static> | WriterError {
  let mut captureWriter = Default.default<CaptureWriter>()
  run writeP3(
    2,
    2,
    255,
    [
      Pixel(255, 0, 0, 255),
      Pixel(0, 255, 0, 255),
      Pixel(0, 0, 255, 255),
      Pixel(255, 255, 255, 255),
    ],
  )
    |> Effect.provideMut(&mut captureWriter)
  run testing.expect(captureWriter.holds(b"P3\n"), "P3 ppm wasn't written")
  // run testing.expectFail(captureWriter.holds(b"p3"), "P3 ppm wasn't written")
}
