/// Unsigned Normalized 8-bit integer
///
/// # Details
///
/// used for alpha channels in pixels and color
/// `Pixel(u8, u8, u8, unorm8)`
pub type unorm8 = u8

/// An sRGB pixel with straight (non-premultiplied) alpha: `Pixel(r, g, b, a)`.
///
/// # Details
///
/// Make one with:
///
/// - `Pixel.new(r, g, b, a)` or `Pixel.opaque(r, g, b)`
/// - `from<Pixel>(value)` from a `u32` in `0xRRGGBBAA` order (`ff` alpha is opaque, `00` is
///   transparent), or from a [`PremultipliedPixel`], owned or as `&`
/// - `Pixel.fromHex("#dc143c")`, which returns `Option<Pixel>`
/// - `Default.default<Pixel>()`, which is opaque black
///
/// Convert out with `from<u32>(pixel)` or `pixel.into<u32>()`, which pack to `0xRRGGBBAA`, and
/// with `from<PremultipliedPixel>(&pixel)` or `pixel.into<PremultipliedPixel>()`. `Pixel` is
/// `Copy`, so none of these consume it.
///
/// # Examples
///
/// ```silk
/// let color: u32 = 0xdc143cff
/// let pixel = from<Pixel>(color)
/// let packed = pixel.into<u32>()                 // 0xdc143cff
/// let parsed = Pixel.fromHex("#dc143c").unwrapOr(Default.default<Pixel>())
/// let premul = from<PremultipliedPixel>(&pixel)
/// ```
///
/// # Gotchas
///
/// The source of `from<Pixel>` must be a `u32`, so give a literal that type first, as above.
/// Converting a [`PremultipliedPixel`] into a `Pixel` is lossy.
pub tuple Pixel(u8, u8, u8, unorm8)

pub struct PixelConversionError {
  pub message: string<'static>
}

impl Pixel {
  pub fn new(r: u8, g: u8, b: u8, a: unorm8) -> Pixel {
    return Pixel(r, g, b, a)
  }

  pub fn opaque(r: u8, g: u8, b: u8) -> Pixel {
    return Pixel(r, g, b, 255)
  }

  pub fn isOpaque(self: &Self) -> bool {
    return u8.equals(self.3, 255)
  }

  pub fn isTransparent(self: &Self) -> bool {
    return u8.equals(self.3, 0)
  }

  /// Makes a `Pixel` from a `u32` in `0xRRGGBBAA` order.
  ///
  /// # Details
  ///
  /// `ff` in the last byte is fully opaque and `00` is fully transparent.
  ///
  /// # Examples
  ///
  /// ```silk
  /// let pixel = Pixel.fromU32(0xdc143cff)
  /// ```
  pub fn fromU32(value: u32) -> Pixel {
    let r: u8 = u32.shiftRight(value, 24)
      |> u32.bitAnd(0xFF)
      |> u32.toU8()
    let g: u8 = u32.shiftRight(value, 16)
      |> u32.bitAnd(0xFF)
      |> u32.toU8()
    let b: u8 = u32.shiftRight(value, 8)
      |> u32.bitAnd(0xFF)
      |> u32.toU8()
    let a: unorm8 = u32.bitAnd(value, 0xFF) |> u32.toU8()
    return Pixel(r, g, b, a)
  }

  /// Packs the pixel into a `u32` in `0xRRGGBBAA` order, the inverse of `fromU32`.
  pub fn toU32(self: &Self) -> u32 {
    let r = u8.toU32(self.0) |> u32.shiftLeft(24)
    let g = u8.toU32(self.1) |> u32.shiftLeft(16)
    let b = u8.toU32(self.2) |> u32.shiftLeft(8)
    let a = u8.toU32(self.3)
    return u32.add(u32.add(r, g), u32.add(b, a))
  }

  /// Returns this pixel with each color channel multiplied by alpha, rounded to nearest.
  pub fn toPremultiplied(self: &Self) -> PremultipliedPixel {
    return premultiplyFromRaw(self.0, self.1, self.2, self.3)
  }

  /// Returns the sRGB pixel of a CSS hex color, or `None` when `text` is not one.
  ///
  /// # Details
  ///
  /// Accepts three, four, six, or eight hex digits after an optional `#`, in either case: `#rgb`,
  /// `#rgba`, `#rrggbb`, and `#rrggbbaa`. A short digit is repeated, so `#f80` is `#ff8800`.
  pub fn fromHex(str: string) -> Option<Pixel> {
    if bool.not(String.startsWith(str, "#")) {
      return Option<Pixel>.none()
    }
    let bytes = String.utf8Bytes(str)
    let mut start: usize = 0
    if bytes.length > 0 && bytes[0] == 35 {
      start = 1
    }

    let count = bytes.length - start

    if count != 3 && count != 4 && count != 6 && count != 8 {
      return Option<Pixel>.none()
    }

    let mut digits: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 15]
    if count == 6 {
      digits[6] = 15
    }
    let mut i: usize = 0
    while i < count {
      let digit = hexDigit(bytes[start + i])
      if digit > 15 {
        return Option<Pixel>.none()
      }
      digits[i] = digit
      i = i + 1
    }

    let mut channels: [u8; 4] = [0, 0, 0, 255]
    let mut channel: usize = 0
    while channel < 4 {
      if count <= 4 {
        if channel < count {
          channels[channel] = digits[channel] * 17
        }
      } else if channel * 2 < count {
        channels[channel] = digits[channel * 2] * 16 + digits[channel * 2 + 1]
      }
      channel = channel + 1
    }
    return Option<Pixel>.some(Pixel(channels[0], channels[1], channels[2], channels[3]))
  }
}

impl Make for Pixel {
  /// Creates a fully opaque black pixel
  pub fn make() -> Pixel {
    return Pixel(0, 0, 0, 255)
  }
}

impl Copy for Pixel {}

impl Debug for Pixel {
  effect fn debug(self: &Pixel, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Format.debugFields(self, "Pixel", &mut formatter)
  }
}

impl Equal for Pixel {
  fn equals(left: &Self, right: &Pixel) -> bool {
    return left.0 == right.0 && left.1 == right.1 && left.2 == right.2 && left.3 == right.3
  }
}

impl From<PremultipliedPixel> for Pixel {
  fn from(value: PremultipliedPixel) -> Pixel {
    return value.toPixel()
  }
}

impl<'a> From<&'a PremultipliedPixel> for Pixel {
  fn from(value: &'a PremultipliedPixel) -> Pixel {
    return value.toPixel()
  }
}

impl From<Pixel> for u32 {
  fn from(value: Pixel) -> u32 {
    return value.toU32()
  }
}

impl Into<Pixel> for Pixel {
  pub fn into<U: From<Pixel>>(self: Self) -> U {
    return From<Pixel>.from(move self)
  }
}

/// A pixel whose color channels are already multiplied by alpha: `PremultipliedPixel(r, g, b, a)`.
///
/// # Details
///
/// Each of `r`, `g`, `b` is at most `a`. Make one with:
///
/// - `from<PremultipliedPixel>(&pixel)` or `pixel.into<PremultipliedPixel>()`, which rounds each
///   channel to `round(c * a / 255)`
/// - `PremultipliedPixel.fromPremultiplied(r, g, b, a)` for values that are already
///   premultiplied. It returns a `Result` and fails with `PixelConversionError` when a color
///   channel exceeds `a`.
/// - `Default.default<PremultipliedPixel>()`, which is opaque black
///
/// Convert back with `from<Pixel>(&premul)` or `premul.into<Pixel>()`. To get a `u32`, go
/// through `Pixel`.
///
/// # Examples
///
/// ```silk
/// let pixel = Pixel(220, 20, 60, 128)
/// let premul = from<PremultipliedPixel>(&pixel)
/// let back = premul.into<Pixel>()                // close to pixel, not always equal
/// let bad = PremultipliedPixel.fromPremultiplied(200, 0, 0, 100)  // fails: 200 > 100
/// ```
///
/// # Gotchas
///
/// Converting to `Pixel` is lossy. A pixel with alpha `0` becomes black, and low alpha leaves
/// few distinct channel values. A round trip is exact only when alpha is `255`.
pub tuple PremultipliedPixel(u8, u8, u8, unorm8)

impl PremultipliedPixel {
  /// Create a PremultipliedPixel from pre-multiplied values
  /// # Details
  /// Returns a Failure result if any of the r,g,b channels exceeds the alpha channel
  pub fn fromPremultiplied(r: u8, g: u8, b: u8, a: unorm8) -> Result<
    PremultipliedPixel,
    PixelConversionError
  > {
    if r > a || g > a || b > a {
      return move Result<PremultipliedPixel, PixelConversionError>.failResult(
        PixelConversionError { message: "Color channels exceed alpha channel" },
      )
    }
    return move Result<PremultipliedPixel, PixelConversionError>.succeed(
      PremultipliedPixel(r, g, b, a),
    )
  }

  /// Returns the straight-alpha `Pixel`. This conversion is lossy.
  ///
  /// # Gotchas
  ///
  /// Alpha `0` gives transparent black, because the color cannot be recovered. Low alpha leaves
  /// few distinct channel values. The round trip is exact only when alpha is `255`.
  pub fn toPixel(self: &Self) -> Pixel {
    if self.3 == 0 {
      return Pixel(0, 0, 0, 0)
    }
    return Pixel(
      unpremultiply(self.0, self.3),
      unpremultiply(self.1, self.3),
      unpremultiply(self.2, self.3),
      self.3,
    )
  }
}

impl Make for PremultipliedPixel {
  pub fn make() -> PremultipliedPixel {
    return PremultipliedPixel(0, 0, 0, 255)
  }
}

impl Copy for PremultipliedPixel {}

impl Debug for PremultipliedPixel {
  effect fn debug(self: &PremultipliedPixel, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Format.debugFields(self, "PremultipliedPixel", &mut formatter)
  }
}

impl Equal for PremultipliedPixel {
  fn equals(left: &Self, right: &PremultipliedPixel) -> bool {
    return left.0 == right.0 && left.1 == right.1 && left.2 == right.2 && left.3 == right.3
  }
}

impl From<Pixel> for PremultipliedPixel {
  fn from(value: Pixel) -> PremultipliedPixel {
    return value.toPremultiplied()
  }
}

impl<'a> From<&'a Pixel> for PremultipliedPixel {
  fn from(value: &'a Pixel) -> PremultipliedPixel {
    return value.toPremultiplied()
  }
}

impl Into<PremultipliedPixel> for PremultipliedPixel {
  pub fn into<U: From<PremultipliedPixel>>(self: Self) -> U {
    return From<PremultipliedPixel>.from(move self)
  }
}

/// Returns the value of an ASCII hex digit, or 16 for any other byte.
fn hexDigit(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  if byte >= 65 && byte <= 70 {
    return byte - 55
  }
  return 16
}

fn premultiplyFromRaw(r: u8, g: u8, b: u8, a: unorm8) -> PremultipliedPixel {
  let out_r = u8.toU16(r) * u8.toU16(a)
    |> divideBy255Rounded()
    |> u16.toU8()
  let out_g = u8.toU16(g) * u8.toU16(a)
    |> divideBy255Rounded()
    |> u16.toU8()
  let out_b = u8.toU16(b) * u8.toU16(a)
    |> divideBy255Rounded()
    |> u16.toU8()

  return PremultipliedPixel(out_r, out_g, out_b, a)
}

/// One channel of the straight value: round(c * 255 / a), clamped to 255. Needs a > 0.
fn unpremultiply(c: u8, a: u8) -> u8 {
  let a32 = u8.toU32(a)
  let v = (u8.toU32(c) * 255 + a32 / 2) / a32
  if v > 255 {
    return 255
  }
  return u32.toU8(v)
}

fn divideBy255Rounded(v: u16) -> u16 {
  return (v + 127) / 255
}

test effect fn testPixelEquality() -> ()
  ! AssertionError<'static> {
  let pixel = Pixel(220, 20, 60, 255)

  run testing.expect(&pixel == &Pixel(220, 20, 60, 255), "not the same pixel")
  run testing.expectFail(&pixel == &Pixel(220, 20, 61, 255), "is the same pixel")
}

test effect fn testPixelConversions() -> ()
  ! AssertionError<'static> | LogError {
  let pixel = Pixel(220, 20, 60, 255)
  let pixel_value: u32 = 0xdc133cff

  run testing.expectFail(&from<u32>(pixel) == &pixel_value, "is the same pixel")

  drop pixel.into<u32>()
  let pixel_2 = Pixel.fromU32(0xdc158b00)

  let r: u8 = 0xdc
  let g: u8 = 0x15
  let b: u8 = 0x8b
  let a: u8 = 0x00
  run testing.expect(&pixel_2.0 == &r, "is not the same pixel red channel")
  run testing.expect(&pixel_2.1 == &g, "is not the same pixel green channel")
  run testing.expect(&pixel_2.2 == &b, "is not the same pixel blue channel")
  run testing.expect(&pixel_2.3 == &a, "is not the same pixel alpha channel")
}

test effect fn testPixelFromHex() -> ()
  ! AssertionError<'static> | LogError {
  let pixel = Pixel.fromHex("#dc143c00").unwrapOr(Default.default<Pixel>())

  run testing.expect(&pixel == &Pixel.fromU32(0xdc143c00), "Not the same pixel")
  run testing.expect(pixel.isTransparent() == true, "pixel isn't transparent")
  run testing.expectFail(Pixel(24, 54, 200, 0).isOpaque() == true, "pixel is actually opaque")
}

test effect fn testPremultipliedPixel() -> ()
  ! AssertionError<'static> | LogError {
  run testing.expectToFail(PremultipliedPixel.fromPremultiplied(24, 102, 29, 100))
  let premuled = from<PremultipliedPixel>(&Pixel(24, 99, 29, 255))
  run testing.expect(
    &premuled == &Pixel(24, 99, 29, 255).into<PremultipliedPixel>(),
    "Isn't the same premulitiplied pixel",
  )

  let premuled_2 = from<PremultipliedPixel>(&Pixel(10, 234, 29, 245))
  let pixel_1 = Pixel(24, 99, 29, 255)
  let premuled_c = pixel_1.into<PremultipliedPixel>()
  let lossy = premuled_c.into<Pixel>()
  let soeal = Pixel.fromU32(0xdc158b00)
  drop (lossy, soeal)

  run testing.expect(premuled_2.0 == 10, "Premultiplied red channel isn't the same")
  run testing.expect(premuled_2.1 == 225, "Premultiplied green channel isn't the same")
  run testing.expect(premuled_2.2 == 28, "Premultiplied blue channel isn't the same")
  run testing.expect(premuled_2.3 == 245, "Premultiplied alpha channel isn't the same")
}
