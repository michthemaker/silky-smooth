//! Assertions for tests, and the filter rules that the test runner uses to select tests.
//!
//! # When to use
//! Use [`testing.expect`] in a `test` function to check a condition. Use [`testing.matches`] or
//! [`testing.matchesQualified`] in a custom test runner that must select tests with the same rules
//! as the built-in runner.
//!
//! # Details
//! An assertion failure is an ordinary typed failure, [`AssertionError`]. It needs no service and
//! holds the message of the caller. A failed `expect` stops the test with that failure.
//!
//! The filters compare the file path exactly. They compare the test name as an ASCII substring and
//! ignore ASCII case. They do not fold non-ASCII letters.
//!
//! # Examples
//! ## Check a condition in a test function
//! ```silk
//! import lib.testing
//!
//! fn double(value: i32) -> i32 {
//!   return value * 2
//! }
//!
//! test effect fn doubleAddsTheValueToItself() -> ()
//!   ! testing.AssertionError<'static> {
//!   run testing.expect(double(21) == 42, "double(21) is 42")
//! }
//!
//! pub fn main() -> i32 {
//!   return 0
//! }
//! ```
//!
//! @category Testing

import silk.testing.testing { Testing as stdTesting }
import silk.core.effect { Effect }
import silk.core.result { Result }
pub import silk.testing.testing { AssertionError }

/// Fails with an [`AssertionError`] that holds `message` if `condition` is `false`.
///
/// # Details
///
/// If `condition` is `true`, this function does nothing. Write `message` as the expected fact,
/// such as `"list is empty"`, so that a failure report reads as the broken expectation.
///
/// # Errors
///
/// - [`AssertionError`] if `condition` is `false`.
pub effect fn expect<'message>(condition: bool, message: string<'message>) -> ()
  ! AssertionError<'message> {
  run stdTesting.expect<'message>(condition, message)
  return ()
}

/// Fails with an [`AssertionError`] that holds `message` if `condition` is `true`.
///
/// # Details
///
/// If `condition` is `false`, this function does nothing. Write `message` as the expected fact,
/// such as `"list is empty"`, so that a failure report reads as the broken expectation.
///
/// # Errors
///
/// - [`AssertionError`] if `condition` is `true`.
pub effect fn expectFail<'message>(condition: bool, message: string<'message>) -> ()
  ! AssertionError<'message> {
  run stdTesting.expect<'message>(!condition, message)
  return ()
}

/// Fails the test unless `computation` fails.
///
/// # Details
///
/// The computation must have no unprovided services. Give it any it needs first, with
/// `Effect.provide` or `Effect.provideMut`. To also check which failure it ends with, use
/// [`expectEffectToFailWith`].
///
/// # Examples
///
/// ```silk
/// struct DivideError {}
///
/// effect fn divide(a: u8, b: u8) -> u8 ! DivideError {
///   if b == 0 { fail DivideError {} }
///   return a / b
/// }
///
/// test effect fn testDivideByZero() -> () ! AssertionError<'static> {
///   run expectEffectToFail(divide(5, 0))
/// }
/// ```
pub effect fn expectEffectToFail<'message, A, E>(computation: once Effect<A ! E>) -> ()
  ! AssertionError<'message> {
  let run_result = run Effect.result(move computation)
  let failed = match move run_result {
    Result<A, E>.Success { .. } => {
      false
    }
    Result<A, E>.Failure { .. } => {
      true
    }
  }
  run stdTesting.expect<'message>(failed, "Computation didn't fail")
  return ()
}

struct Caught {}

/// Fails the test unless `computation` fails with the failure type `S`.
///
/// # Details
///
/// Write `S` as the first type argument, as in `expectEffectToFailWith<DivideError>(computation)`.
/// `S` must be one of the failure types of `computation`, so a type it cannot fail with is a
/// compile error. Any other failure fails the test. As with [`expectEffectToFail`], the
/// computation must have no unprovided services.
///
/// # Examples
///
/// ```silk
/// test effect fn testDivideByZeroError() -> () ! AssertionError<'static> {
///   run expectEffectToFailWith<DivideError>(divide(5, 0))
/// }
/// ```
///
/// # Gotchas
///
/// A trap is not a typed failure, so this cannot expect one.
pub effect fn expectEffectToFailWith<'message, S, A, E>(computation: once Effect<A ! E>) -> ()
  ! AssertionError<'message> where S in E {
  let narrowed = Effect.catch<S>(
    move computation,
    effect fn(error: S) -> Caught {
      return Caught {}
    },
  )
  let outcome = run Effect.result(move narrowed)
  match move outcome {
    Result<A | Caught, Without<E, S>>.Failure { .. } => {
      run stdTesting.expect<'message>(false, "Computation failed with a different error")
    }
    Result<A | Caught, Without<E, S>>.Success { value } => {
      match move value {
        Caught {} => {
          run stdTesting.expect<'message>(true, "")
        }
        _ => {
          run stdTesting.expect<'message>(false, "Computation didn't fail")
        }
      }
    }
  }
  return ()
}

/// Fails the test unless `result` is a failure.
///
/// # Details
///
/// This checks a value you already have. To check an effect that has not run yet, use
/// [`expectEffectToFail`].
///
/// # Examples
///
/// ```silk
/// struct DivideError {}
///
/// test effect fn testFailure() -> () ! AssertionError<'static> {
///   let result = Result<u8, DivideError>.failResult(DivideError {})
///   run expectToFail(result)
/// }
/// ```
pub effect fn expectToFail<'message, A, F>(result: Result<A, F>) -> ()
  ! AssertionError<'message> {
  let failed = match move result {
    Result<A, F>.Success { .. } => {
      false
    }
    Result<A, F>.Failure { .. } => {
      true
    }
  }
  run stdTesting.expect<'message>(failed, "Result didn't fail")
  return ()
}

/// Fails the test unless `result` is a success.
///
/// # Details
///
/// This checks a value you already have. To check an effect that has not run yet, use
/// [`expectEffectToNotFail`].
///
/// # Examples
///
/// ```silk
/// struct DivideError {}
///
/// test effect fn testSuccess() -> () ! AssertionError<'static> {
///   let result = Result<u8, DivideError>.succeed(2)
///   run expectToNotFail(result)
/// }
/// ```
pub effect fn expectToNotFail<'message, A, F>(result: Result<A, F>) -> ()
  ! AssertionError<'message> {
  let succeeded = match move result {
    Result<A, F>.Success { .. } => {
      true
    }
    Result<A, F>.Failure { .. } => {
      false
    }
  }
  run stdTesting.expect<'message>(succeeded, "Result failed")
  return ()
}

/// Returns the message of an [`AssertionError`].
pub fn assertionMessage<'message>(error: &'message AssertionError<'message>) -> string<'message> {
  return stdTesting.assertionMessage(error)
}

/// Returns `true` if a test with file `path` and name `name` passes both filters.
///
/// # Details
///
/// - `fileFilter` must be equal to `path`, byte for byte. An empty `fileFilter` passes each file.
/// - `nameFilter` must occur in `name`. The comparison ignores ASCII case. An empty `nameFilter`
///   passes each name.
///
/// # Gotchas
///
/// The name comparison folds only ASCII letters. Other letters must match exactly.
pub fn matches(path: string, name: string, fileFilter: string, nameFilter: string) -> bool {
  return stdTesting.matches(path, name, fileFilter, nameFilter)
}

/// Returns `true` if a test passes both filters, where the name filter applies to the qualified
/// name `module::name`.
///
/// # When to use
///
/// Use this function in a custom runner that reports tests by qualified name, as the built-in
/// runner does. Use [`Testing.matches`] to match the plain name only.
///
/// # Details
///
/// `fileFilter` must be equal to `path`, byte for byte. An empty `fileFilter` passes each file.
/// `nameFilter` can occur anywhere in
/// `module::name`, also across the `::` separator. The comparison ignores ASCII case.
pub fn matchesQualified(
  path: string,
  module: string,
  name: string,
  fileFilter: string,
  nameFilter: string,
) -> bool {
  return stdTesting.matchesQualified(path, module, name, fileFilter, nameFilter)
}
