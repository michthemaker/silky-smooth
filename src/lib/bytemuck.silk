import silk.core.ownership { Copy }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.core.option { Option }

/// Cast `&[A]` into `&[B]`.
///
/// ## Panics
///
/// This is [`tryCastSlice`] but will panic on error.
pub fn castMutSlice<'a, B: Copy, A: Copy>(a: &'a mut [A]) -> &'a mut [B] {
  let a_bytes = Layout.of<A>().bytes
  let b_bytes = Layout.of<B>().bytes

  let total = usize.wrappingMultiply(a.length, a_bytes)
  let maybe_ptr = Pointer.fromMutSlice(&mut a)
  let ptr = match Pointer.nonNullManyMut(maybe_ptr) {
    Option<[*]mut A>.Some { value } => value
    Option<[*]mut A>.None => {
      Intrinsic.trap("an array is never at null")
    }
  }
  let new_ptr = unsafe Intrinsic.pointerReinterpret<[*]mut A, [*]mut B>(ptr)
  return unsafe Intrinsic.pointerBorrowManyMut<A, B>(a, new_ptr, total / b_bytes)
}

pub fn castSlice<'a, B: Copy, A: Copy>(a: &'a [A]) -> &'a [B] {
  let a_bytes = Layout.of<A>().bytes
  let b_bytes = Layout.of<B>().bytes

  let total = usize.wrappingMultiply(a.length, a_bytes)
  let maybe_ptr = Pointer.fromSlice(a)
  let ptr = match Pointer.nonNullMany(maybe_ptr) {
    Option<[*]const A>.Some { value } => value
    Option<[*]const A>.None => {
      Intrinsic.trap("an array is never at null")
    }
  }
  unsafe {
    let new_ptr = Intrinsic.pointerReinterpret<[*]const A, [*]const B>(ptr)
    return Intrinsic.pointerBorrowMany<A, B>(a, new_ptr, total / b_bytes)
  }
}
