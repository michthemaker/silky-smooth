//! Default values for types that have one obvious starting value.
//!
//! # When to use
//! Implement [`Make`] for a type with one obvious default, such as the origin for a point or
//! transparent black for a pixel. Generic code can then create one with [`Default.default`].
//!
//! @category Core

/// A type that can create its own default value.
///
/// # Details
///
/// `make` takes no arguments, so the compiler picks the implementation from the type the call
/// must return. Call it as `Make.make()` or through [`Default.default`]. Each type states its
/// own default; nothing is derived from its fields.
///
/// # Examples
///
/// ```silk
/// import lib.default { Default, Make }
///
/// struct Counter {
///   pub count: i32,
/// }
///
/// impl Make for Counter {
///   fn make() -> Self {
///     return Counter { count: 0 }
///   }
/// }
///
/// pub fn main() -> i32 {
///   let counter = Default.default<Counter>()
///   if counter.count != 0 {
///     return 1
///   }
///   return 0
/// }
/// ```
///
/// # Gotchas
///
/// `make` is a plain `fn`, so it cannot use services such as the `Allocator` or report an
/// error. Such types should offer a named constructor instead, as should types with several
/// reasonable defaults (`origin`, `opaque`).
pub interface Make {
  /// Returns the default value of `Self`.
  fn make() -> Self
}

/// The owner type of [`Default.default`]. It has no fields and is never constructed.
pub struct Default {}

impl Default {
  /// Returns the default value of `T`, as made by its [`Make`] implementation.
  ///
  /// # Details
  ///
  /// For generic code that knows only that `T` implements [`Make`]. Where the type is known,
  /// `Make.make()` gives the same result.
  pub fn default<T: Make>() -> T {
    // The return type selects the implementation; `T.make()` is not accepted here.
    return Make.make()
  }
}
