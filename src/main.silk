import lib.convert { hold }
import lib.iter { range, Step }
import lib.println { println }
import silk.io.logger { LogError }

pub effect fn main() -> i32
  ! LogError {
  let mut iter = range(0, 5)
  while let Step.Index { i } = move iter.next() {
    run println("{}", &.(i))
  }

  drop hold
  return 0
}
